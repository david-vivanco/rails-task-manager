<h1>New Task</h1>

<%= form_with model: @task do |f| %>
  <%= f.label :title %>
  <%= f.text_field :title %>
  <%= f.label :details %>
  <%= f.text_field :details %>
  <%= f.submit %>
<% end %>

<div class = "mt-3">
  <%= link_to tasks_path do %>
    <i class="fas fa-arrow-left"></i> Back to list
  <% end %>
</div>
